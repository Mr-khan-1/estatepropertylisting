<%- include('partials/header') %>

<!-- Hero -->
<section class="hero-section">
  <div class="hero-overlay"></div>
  <div class="container hero-content">
    <div class="row justify-content-center text-center">
      <div class="col-lg-8">
        <p class="hero-tagline">FIND YOUR DREAM PROPERTY</p>
        <h1 class="hero-title">Discover the Perfect <span class="text-accent">Home</span> for You</h1>
        <p class="hero-sub">Explore thousands of properties for sale and rent across the country</p>
        <!-- React-powered Search Bar -->
        <div class="hero-search-box shadow-lg">
          <div id="react-search-bar"></div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Stats -->
<section class="stats-section">
  <div class="container">
    <div class="row g-4 text-center">
      <div class="col-md-4">
        <div class="stat-box"><div class="stat-number"><%= totalProperties %>+</div><div class="stat-label">Active Listings</div></div>
      </div>
      <div class="col-md-4">
        <div class="stat-box"><div class="stat-number"><%= totalAgents %>+</div><div class="stat-label">Verified Agents</div></div>
      </div>
      <div class="col-md-4">
        <div class="stat-box"><div class="stat-number">98%</div><div class="stat-label">Happy Clients</div></div>
      </div>
    </div>
  </div>
</section>

<!-- Featured Properties -->
<section class="section-padding">
  <div class="container">
    <div class="section-header text-center mb-5">
      <p class="section-tag">HAND-PICKED FOR YOU</p>
      <h2 class="section-title">Featured Properties</h2>
    </div>
    <% if (featuredProperties.length === 0) { %>
      <div class="text-center py-5">
        <i class="bi bi-house-x display-1 text-muted"></i>
        <p class="mt-3 text-muted">No properties available yet. Check back soon!</p>
      </div>
    <% } else { %>
      <div class="row g-4">
        <% featuredProperties.forEach(property => { %>
          <%- include('partials/property-card', { property }) %>
        <% }) %>
      </div>
      <div class="text-center mt-5">
        <a href="/properties" class="btn btn-outline-primary btn-lg px-5">View All Properties <i class="bi bi-arrow-right ms-2"></i></a>
      </div>
    <% } %>
  </div>
</section>

<!-- Why Choose Us -->
<section class="section-padding bg-light">
  <div class="container">
    <div class="section-header text-center mb-5">
      <p class="section-tag">WHY ESTATEHUB</p>
      <h2 class="section-title">Your Trusted Real Estate Partner</h2>
    </div>
    <div class="row g-4">
      <div class="col-md-3 text-center">
        <div class="feature-icon"><i class="bi bi-shield-check"></i></div>
        <h5 class="mt-3">Verified Listings</h5>
        <p class="text-muted">Every property is reviewed and approved by our admin team before going live.</p>
      </div>
      <div class="col-md-3 text-center">
        <div class="feature-icon"><i class="bi bi-geo-alt"></i></div>
        <h5 class="mt-3">Map Integration</h5>
        <p class="text-muted">Visualize property locations with OpenStreetMap and Leaflet.</p>
      </div>
      <div class="col-md-3 text-center">
        <div class="feature-icon"><i class="bi bi-bar-chart"></i></div>
        <h5 class="mt-3">Compare Properties</h5>
        <p class="text-muted">Side-by-side comparison to help you make the best decision.</p>
      </div>
      <div class="col-md-3 text-center">
        <div class="feature-icon"><i class="bi bi-star"></i></div>
        <h5 class="mt-3">Reviews & Ratings</h5>
        <p class="text-muted">Genuine reviews from real users to guide your choice.</p>
      </div>
    </div>
  </div>
</section>

<!-- CTA -->
<section class="cta-section">
  <div class="container text-center">
    <h2 class="text-white mb-3">Are You an Agent or Seller?</h2>
    <p class="text-white-50 mb-4">List your properties and reach thousands of potential buyers and renters today.</p>
    <a href="/auth/register" class="btn btn-accent btn-lg px-5">List Your Property <i class="bi bi-arrow-right ms-2"></i></a>
  </div>
</section>

<%- include('partials/footer') %>
