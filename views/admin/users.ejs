<%- include('../partials/header') %>
<section class="section-padding">
  <div class="container">
    <h2 class="section-title mb-4">Manage Users</h2>
    <div class="detail-card">
      <div class="table-responsive">
        <table class="table table-hover align-middle">
          <thead><tr><th>Name</th><th>Email</th><th>Role</th><th>Phone</th><th>Status</th><th>Joined</th><th>Actions</th></tr></thead>
          <tbody>
            <% users.forEach(u => { %>
            <tr>
              <td><strong><%= u.name %></strong></td>
              <td><%= u.email %></td>
              <td><span class="badge bg-<%= u.role === 'agent' ? 'primary' : 'secondary' %>"><%= u.role %></span></td>
              <td><%= u.phone || 'N/A' %></td>
              <td><span class="badge bg-<%= u.isActive ? 'success' : 'danger' %>"><%= u.isActive ? 'Active' : 'Inactive' %></span></td>
              <td><%= new Date(u.createdAt).toLocaleDateString() %></td>
              <td>
                <form action="/admin/toggle-user/<%= u._id %>" method="POST" class="d-inline">
                  <button class="btn btn-sm btn-outline-<%= u.isActive ? 'warning' : 'success' %>"><%= u.isActive ? 'Deactivate' : 'Activate' %></button>
                </form>
                <form action="/admin/user/<%= u._id %>?_method=DELETE" method="POST" class="d-inline" onsubmit="return confirm('Delete this user?')">
                  <button class="btn btn-sm btn-outline-danger ms-1"><i class="bi bi-trash"></i></button>
                </form>
              </td>
            </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</section>
<%- include('../partials/footer') %>
