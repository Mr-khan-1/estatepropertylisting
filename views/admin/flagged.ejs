<%- include('../partials/header') %>
<section class="section-padding">
  <div class="container">
    <h2 class="section-title mb-4">Flagged Properties</h2>
    <% if (properties.length === 0) { %>
      <div class="text-center py-5"><i class="bi bi-flag display-1 text-muted"></i><h4 class="mt-3">No Flagged Properties</h4></div>
    <% } else { %>
    <div class="row g-4">
      <% properties.forEach(p => { %>
        <div class="col-md-6">
          <div class="detail-card border-danger border">
            <div class="d-flex gap-3">
              <img src="<%= p.images && p.images.length > 0 ? '/uploads/'+p.images[0] : '/images/placeholder.svg' %>" style="width:100px;height:80px;object-fit:cover;border-radius:8px;"/>
              <div class="flex-grow-1">
                <h5 class="mb-1"><%= p.title %></h5>
                <p class="text-muted small mb-1"><i class="bi bi-person me-1"></i><%= p.agent ? p.agent.name : 'Unknown' %></p>
                <div class="alert alert-danger py-1 px-2 mb-2 small"><i class="bi bi-flag me-1"></i><%= p.flagReason || 'No reason provided' %></div>
                <div class="d-flex gap-2">
                  <a href="/properties/<%= p._id %>" target="_blank" class="btn btn-sm btn-outline-primary">Preview</a>
                  <form action="/admin/approve/<%= p._id %>" method="POST" class="d-inline"><button class="btn btn-sm btn-success">Approve</button></form>
                  <form action="/admin/reject/<%= p._id %>" method="POST" class="d-inline"><button class="btn btn-sm btn-danger">Remove</button></form>
                  <form action="/admin/clear-flag/<%= p._id %>" method="POST" class="d-inline"><button class="btn btn-sm btn-outline-secondary">Clear Flag</button></form>
                </div>
              </div>
            </div>
          </div>
        </div>
      <% }) %>
    </div>
    <% } %>
  </div>
</section>
<%- include('../partials/footer') %>
