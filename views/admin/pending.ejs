<%- include('../partials/header') %>
<section class="section-padding">
  <div class="container">
    <h2 class="section-title mb-4">Pending Listings</h2>
    <% if (properties.length === 0) { %>
      <div class="text-center py-5"><i class="bi bi-check-all display-1 text-success"></i><h4 class="mt-3">All Clear!</h4><p class="text-muted">No pending listings to review.</p></div>
    <% } else { %>
    <div class="row g-4">
      <% properties.forEach(p => { %>
        <div class="col-md-6">
          <div class="detail-card">
            <div class="d-flex gap-3">
              <img src="<%= p.images && p.images.length > 0 ? '/uploads/'+p.images[0] : '/images/placeholder.svg' %>" style="width:100px;height:80px;object-fit:cover;border-radius:8px;"/>
              <div class="flex-grow-1">
                <h5 class="mb-1"><%= p.title %></h5>
                <p class="text-muted small mb-1"><i class="bi bi-person me-1"></i><%= p.agent ? p.agent.name : 'Unknown' %> &nbsp; <i class="bi bi-geo-alt me-1"></i><%= p.city %></p>
                <p class="text-primary fw-bold mb-2">PKR <%= p.price.toLocaleString() %> &nbsp; <span class="badge-type badge-<%= p.type %>"><%= p.type %></span></p>
                <div class="d-flex gap-2">
                  <a href="/properties/<%= p._id %>" target="_blank" class="btn btn-sm btn-outline-primary"><i class="bi bi-eye me-1"></i>Preview</a>
                  <form action="/admin/approve/<%= p._id %>" method="POST" class="d-inline"><button type="submit" class="btn btn-sm btn-success"><i class="bi bi-check-lg me-1"></i>Approve</button></form>
                  <form action="/admin/reject/<%= p._id %>" method="POST" class="d-inline"><button type="submit" class="btn btn-sm btn-danger"><i class="bi bi-x-lg me-1"></i>Reject</button></form>
                </div>
              </div>
            </div>
          </div>
        </div>
      <% }) %>
    </div>
    <% } %>
  </div>
</section>
<%- include('../partials/footer') %>
