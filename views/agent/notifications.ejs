<%- include('../partials/header') %>
<section class="section-padding">
  <div class="container">
    <div class="row justify-content-center">
      <div class="col-lg-7">
        <h2 class="section-title mb-4">Notifications</h2>
        <% if (notifications.length === 0) { %>
          <div class="text-center py-5"><i class="bi bi-bell-slash display-1 text-muted"></i><h4 class="mt-3">No Notifications</h4></div>
        <% } else { %>
          <% notifications.forEach(n => { %>
            <div class="detail-card mb-3 d-flex align-items-center gap-3">
              <div class="notif-icon bg-primary"><i class="bi bi-bell-fill"></i></div>
              <div class="flex-grow-1">
                <p class="mb-0"><%= n.message %></p>
                <small class="text-muted"><%= new Date(n.createdAt).toLocaleString() %></small>
              </div>
            </div>
          <% }) %>
        <% } %>
      </div>
    </div>
  </div>
</section>
<%- include('../partials/footer') %>
