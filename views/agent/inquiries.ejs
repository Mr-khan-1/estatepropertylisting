<%- include('../partials/header') %>
<section class="section-padding">
  <div class="container">
    <h2 class="section-title mb-4">Property Inquiries</h2>
    <% if (inquiries.length === 0) { %>
      <div class="text-center py-5"><i class="bi bi-envelope-x display-1 text-muted"></i><h4 class="mt-3">No Inquiries Yet</h4></div>
    <% } else { %>
    <div class="row g-3">
      <% inquiries.forEach(inq => { %>
        <div class="col-12">
          <div class="detail-card">
            <div class="row g-3 align-items-center">
              <div class="col-md-2 text-center"><i class="bi bi-person-circle display-4 text-primary"></i><br/><strong><%= inq.sender ? inq.sender.name : 'User' %></strong></div>
              <div class="col-md-7">
                <p class="mb-1"><i class="bi bi-house me-1"></i><strong><%= inq.property ? inq.property.title : 'Property' %></strong></p>
                <p class="mb-1 text-muted"><i class="bi bi-envelope me-1"></i><%= inq.email %> &nbsp; <i class="bi bi-telephone me-1"></i><%= inq.phone || 'N/A' %></p>
                <p class="mb-0"><%= inq.message %></p>
              </div>
              <div class="col-md-3 text-end"><small class="text-muted"><%= new Date(inq.createdAt).toLocaleDateString() %></small></div>
            </div>
          </div>
        </div>
      <% }) %>
    </div>
    <% } %>
  </div>
</section>
<%- include('../partials/footer') %>
