<%- include('../partials/header') %>
<section class="section-padding">
  <div class="container">
    <h2 class="section-title mb-2">My Favorite Properties</h2>
    <p class="text-muted mb-4"><%= properties.length %> saved properties</p>
    <% if (properties.length === 0) { %>
      <div class="text-center py-5">
        <i class="bi bi-heart display-1 text-muted"></i>
        <h4 class="mt-3">No Favorites Yet</h4>
        <p class="text-muted">Save properties you like and they'll appear here.</p>
        <a href="/properties" class="btn btn-primary">Browse Properties</a>
      </div>
    <% } else { %>
      <div class="row g-4">
        <% properties.forEach(property => { %><%- include('../partials/property-card', { property }) %><% }) %>
      </div>
    <% } %>
  </div>
</section>
<%- include('../partials/footer') %>
