<%- include('../partials/header') %>
<section class="section-padding">
  <div class="container">
    <div class="section-header mb-4">
      <h2 class="section-title">Browse Properties</h2>
      <p class="text-muted"><%= properties.length %> properties found</p>
    </div>

    <!-- React-powered Filters -->
    <div class="filter-box mb-4">
      <div
        id="react-property-filters"
        data-query="<%- JSON.stringify(query) %>"
      ></div>
    </div>

    <!-- React-powered Compare Bar -->
    <div id="react-compare-bar"></div>

    <% if (properties.length === 0) { %>
      <div class="text-center py-5">
        <i class="bi bi-house-x display-1 text-muted"></i>
        <h4 class="mt-3">No properties found</h4>
        <p class="text-muted">Try adjusting your filters</p>
        <a href="/properties" class="btn btn-primary">Clear Filters</a>
      </div>
    <% } else { %>
      <div class="row g-4">
        <% properties.forEach(property => { %><%- include('../partials/property-card', { property }) %><% }) %>
      </div>
    <% } %>
  </div>
</section>
<%- include('../partials/footer') %>
