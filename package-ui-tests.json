{
  "name": "estate-pk-ui-tests",
  "version": "1.0.0",
  "description": "Playwright UI Testing Suite for e-state property pk",
  "type": "module",
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:debug": "playwright test --debug",
    "test:headed": "playwright test --headed",
    "test:auth": "playwright test tests/ui/authentication.spec.js",
    "test:properties": "playwright test tests/ui/property-creation.spec.js",
    "test:search": "playwright test tests/ui/property-search.spec.js",
    "test:footer": "playwright test tests/ui/footer-layout.spec.js",
    "test:chromium": "playwright test --project=chromium",
    "test:firefox": "playwright test --project=firefox",
    "test:webkit": "playwright test --project=webkit",
    "report": "playwright show-report",
    "codegen": "playwright codegen http://localhost:3000",
    "install-browsers": "playwright install"
  },
  "keywords": [
    "playwright",
    "testing",
    "automation",
    "e-state",
    "property",
    "pakistan"
  ],
  "dependencies": {
    "express": "^4.18.2",
    "mongoose": "^7.0.0",
    "passport": "^0.6.0",
    "ejs": "^3.1.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.40.1",
    "jest": "^29.5.0"
  },
  "engines": {
    "node": ">=16.0.0"
  }
}
