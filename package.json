{
  "name": "estate2.0",
  "version": "2.0.0",
  "description": "Real Estate Property Listing and Management System with Playwright Testing",
  "author": "Muhammad (https://github.com/Mr-khan-1)",
  "contributors": [
    {
      "name": "Muhammad",
      "url": "https://github.com/Mr-khan-1"
    },
    {
      "name": "Asif",
      "url": "https://github.com/masif078"
    },
    {
      "name": "Rana Hammad Mushtaq",
      "url": "https://github.com/RanaHammadMushtaq"
    },
    {
      "name": "Abdullah Khalid Awan",
      "url": "https://github.com/abdullahkhalidawan05"
    }
  ],
  "type": "module",
  "main": "app.js",
  "scripts": {
    "start": "node app.js",
    "dev": "nodemon app.js",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:ui": "playwright test --ui",
    "test:debug": "playwright test --debug",
    "test:headed": "playwright test --headed",
    "test:auth": "playwright test tests/ui/authentication.spec.js",
    "test:properties": "playwright test tests/ui/property-creation.spec.js",
    "test:search": "playwright test tests/ui/property-search.spec.js",
    "test:footer": "playwright test tests/ui/footer-layout.spec.js",
    "test:chromium": "playwright test --project=chromium",
    "test:firefox": "playwright test --project=firefox",
    "test:webkit": "playwright test --project=webkit",
    "test:load": "artillery run tests/load_test.yml",
    "test:stress": "artillery run tests/stress_test.yml",
    "report": "playwright show-report",
    "codegen": "playwright codegen http://localhost:3000",
    "install-browsers": "playwright install"
  },
  "keywords": [
    "real-estate",
    "property",
    "pakistan",
    "playwright",
    "testing",
    "automation"
  ],
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "connect-flash": "^0.1.1",
    "connect-mongo": "^5.1.0",
    "dotenv": "^16.3.1",
    "ejs": "^3.1.9",
    "express": "^4.18.2",
    "express-session": "^1.17.3",
    "method-override": "^3.0.0",
    "mongoose": "^7.6.3",
    "multer": "^1.4.5-lts.1",
    "passport": "^0.6.0",
    "passport-local": "^1.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.0",
    "jest": "^29.7.0",
    "nodemon": "^3.0.1",
    "supertest": "^7.2.2"
  },
  "engines": {
    "node": ">=16.0.0"
  }
}
